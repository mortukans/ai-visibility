{
  "name": "ai-visibility",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Check whether your site gets mentioned and cited by AI models (web-grounded), across many models, via OpenRouter. BYOK.",
  "scripts": {
    "check": "tsx src/cli.ts",
    "history": "tsx src/history.ts",
    "api": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply ai-visibility",
    "migrate:local": "wrangler d1 migrations apply ai-visibility --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
